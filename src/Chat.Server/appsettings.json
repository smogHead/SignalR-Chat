{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Issuer": "chat-server",
    "Audience": "chat-clients",
    "SigningKey": "",
    "LifetimeMinutes": 720
  },
  "Chat": {
    "HistoryPerRoom": 500
  }
}
